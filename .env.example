# Storybook Export-PDF Worker (ADR-055) — env template. Copy to .env.

# --- Bind (loopback-only; nginx never exposes this worker) -----------------
HOST=127.0.0.1
PORT=3203

# --- S2S auth (python-api ⇄ worker) ----------------------------------------
# X-Worker-Token shared secret. MUST equal python-api's EXPORT_PDF_WORKER_TOKEN.
EXPORT_PDF_WORKER_TOKEN=change-me-worker-token

# --- Print render (Chromium navigates the FE print page) -------------------
PRINT_RENDER_BASE_URL=http://localhost:3000
# HS256 render-token secret. MUST equal python-api's PRINT_RENDER_TOKEN_SECRET
# (its get-render-preview verifier decodes worker-signed per-spread tokens).
PRINT_RENDER_TOKEN_SECRET=change-me-render-token-secret-32bytes-min

# --- Storage service (S2S PUT of the finished PDF, ADR-054) ----------------
# Loopback WRITE endpoint (public domain 403s writes).
STORAGE_SERVICE_URL=http://127.0.0.1:8200
STORAGE_SERVICE_API_KEY=change-me-storage-key
# Public base used only as a fallback when the service response omits data.url.
STORAGE_PUBLIC_BASE_URL=http://127.0.0.1:8200

# --- ICC color -------------------------------------------------------------
# Empty → repo-local icc-profiles/ dir.
ICC_PROFILE_DIR=
DEFAULT_ICC_PROFILE_ID=fogra39

# --- Queue / pipeline ------------------------------------------------------
EXPORT_SEM_CAP=1
QUEUE_MAX=4
WORKER_JOB_TIMEOUT_SEC=1800
SHUTDOWN_TIMEOUT_SEC=25
JOB_RETENTION_SEC=1800
